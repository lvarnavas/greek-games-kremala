# ---- Server (server/src/index.ts) ----
# Θύρα και διεύθυνση ακρόασης του Node/Socket.IO server
PORT=3001
HOST=0.0.0.0
# Επιτρεπόμενα origins για CORS (χωρισμένα με κόμμα). Χρειάζεται μόνο αν ο
# client σερβίρεται από άλλο domain από τον server.
# CLIENT_ORIGIN=https://kremala.example.com
# Φάκελος με το build του client (προεπιλογή: client/dist)
# STATIC_DIR=/app/client/dist
# Καθυστέρηση (ms) πριν ξεκινήσει αυτόματα ο επόμενος online γύρος
AUTO_NEXT_MS=20000

# ---- Client (Vite, ορίζονται κατά το build) ----
# URL του server αν είναι σε άλλο domain. Κενό = ίδιο origin.
# VITE_SERVER_URL=https://api.kremala.example.com
# Proxy του Vite dev server προς τον backend (μόνο για development)
# VITE_DEV_SERVER_PROXY=http://localhost:3001
