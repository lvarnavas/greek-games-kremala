{
  "name": "@kremala/server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --target=node20 --outfile=dist/index.js --packages=external --alias:@kremala/shared=../shared/src/index.ts",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "express": "4.21.2",
    "socket.io": "4.8.4"
  },
  "devDependencies": {
    "@kremala/shared": "1.0.0",
    "@types/express": "5.0.0",
    "@types/node": "22.10.2",
    "esbuild": "0.28.2",
    "socket.io-client": "4.8.4",
    "tsx": "4.23.15"
  }
}
